# Copy to `.env` (git-ignored) and fill in. Never put a real value in THIS file:
# it is committed to git. Real values belong only in `.env` locally and in your
# host's environment settings (Render) in production.

# =============================================================================
# Environment
# =============================================================================
# "production" turns on: JSON logs, HSTS, API docs OFF, and a refusal to start
# with authentication disabled. Leave as "development" locally.
ENVIRONMENT=development

# =============================================================================
# Authentication (the API refuses to start in production without these)
# =============================================================================
# LOCAL DEVELOPMENT ONLY: skip login (you act as an admin called "Developer").
# Refused when ENVIRONMENT=production. The customer portal needs real sign-in,
# so set this to false to try customers and investigators locally.
AUTH_DISABLED=true

# The admin account (the organization's owner). It signs in, then creates
# investigator and customer accounts on the People page. For a real login set
# AUTH_DISABLED=false and generate the next two values with:
#   uv run python scripts/hash_password.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# At least 32 random characters; use a DIFFERENT one per environment.
JWT_SECRET=
TOKEN_TTL_MINUTES=480
LOGIN_ATTEMPTS_PER_MINUTE=5
# Per-account lockout (stored in the database): failures before locking, and for how long.
LOCKOUT_AFTER_FAILURES=5
LOCKOUT_MINUTES=15

# =============================================================================
# Groq (LLM recommendations)
# =============================================================================
# Create a key at https://console.groq.com/keys (use a key dedicated to this project).
# Without it the app still works: every recommendation comes from the rules fallback.
GROQ_API_KEY=

# Model id; see https://console.groq.com/docs/models for the current list. Pick a
# production model that supports JSON mode. Which models work depends on your Groq
# organisation: list yours with
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b

# gpt-oss models reason internally; "low" keeps answers well inside GROQ_MAX_OUTPUT_TOKENS.
# Leave this EMPTY for non-reasoning models (e.g. Llama): Groq returns HTTP 400 for a
# reasoning_effort value the model does not support.
GROQ_REASONING_EFFORT=low

# --- Cost / abuse limits (defaults shown) ------------------------------------
# Every HTTP attempt counts, including retries. Exceeding either cap falls back
# to rules instead of calling the API. Keep these under your Groq plan's limits
# (see https://console.groq.com/docs/rate-limits).
GROQ_MAX_CALLS_PER_MINUTE=10
GROQ_MAX_CALLS_PER_DAY=200
GROQ_MAX_OUTPUT_TOKENS=600
GROQ_TIMEOUT_S=20
GROQ_MAX_RETRIES=1
# On HTTP 429 the `retry-after` header is honoured only if it is this short (seconds);
# a longer wait falls back to rules immediately instead of stalling the request.
GROQ_MAX_RETRY_WAIT_S=5
# Circuit breaker: stop calling Groq after N consecutive failures for a cooldown.
GROQ_BREAKER_FAILURES=3
GROQ_BREAKER_COOLDOWN_S=60
# Identical (score + evidence) prompts reuse the previous answer for this long.
GROQ_CACHE_TTL_S=3600

# =============================================================================
# API
# =============================================================================
# Browser origins allowed to call the API: your deployed frontend URL(s),
# comma separated, no trailing slash. Never "*" (refused in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max POST /claims per minute per client IP.
CLAIMS_PER_MINUTE_PER_CLIENT=20
# Requests with a larger body are rejected with 413.
MAX_BODY_BYTES=65536

# =============================================================================
# Storage
# =============================================================================
# Production: a Postgres connection string, e.g. from Neon's free tier
# (Dashboard -> Connect). All data lives there. Keep it secret.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Local development: leave DATABASE_URL unset and SQLite files are used under DATA_DIR.
# (In production, setting DATA_DIR instead is only valid with a persistent disk.)
# DATA_DIR=data

# =============================================================================
# Optional overrides
# =============================================================================
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# CLAIMS_DB_PATH=data/claims.db
# FEEDBACK_DB_PATH=data/feedback.db
# MODEL_PATH=models/model.pkl
# LOG_LEVEL=INFO
# LOG_FORMAT=text          # "json" is the default in production

# =============================================================================
# Public demo (optional): one-click, password-free sandbox for visitors
# =============================================================================
# Each visitor gets a private sandbox: their own claims, invisible to everyone else,
# never used for retraining or similar-claims evidence, purged after a day. They
# cannot create accounts. Unset (or false) to switch the demo off instantly.
# On first start it also seeds sample claims so the dashboards are not empty.
# DEMO_ENABLED=false
# DEMO_MAX_CLAIMS=5                  # claims one visitor may file
# DEMO_TOKEN_TTL_MINUTES=60          # how long a demo session lasts
# DEMO_REQUESTS_PER_MINUTE=90        # per visitor
# DEMO_STARTS_PER_HOUR_PER_IP=12     # new demo sessions per address
# DEMO_STARTS_PER_HOUR_TOTAL=200     # new demo sessions overall
# DEMO_AI_CALLS_PER_DAY=60           # shared by ALL visitors; after that, rules-based advice
# DEMO_DATA_TTL_HOURS=24             # sandbox claims are purged after this long
# DEMO_SEED_CLAIMS=24                # sample claims created on first start
# DEMO_CONTACT_URL=https://a-iportfolio-sigma.vercel.app/   # where visitors who hit a limit are sent
