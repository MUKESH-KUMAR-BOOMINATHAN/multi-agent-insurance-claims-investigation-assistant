# Copy to `.env.local` for local overrides. On Vercel, set this under
# Project -> Settings -> Environment Variables (it is baked in at BUILD time,
# so redeploy after changing it).
#
# NOT a secret: everything prefixed VITE_ ends up in the public JavaScript bundle.
# Never put a key or password here.

# URL of the deployed API (no trailing slash). Defaults to http://127.0.0.1:8000.
VITE_API_URL=https://your-api.onrender.com
